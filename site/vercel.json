{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/((?!odeme).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://app.cal.com https://www.paytr.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xjbqesljonbbduldeesd.supabase.co; font-src 'self'; connect-src 'self' https://xjbqesljonbbduldeesd.supabase.co wss://xjbqesljonbbduldeesd.supabase.co; frame-src https://tally.so https://app.cal.com https://cal.com https://player.vimeo.com https://www.paytr.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/odeme(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://tally.so https://app.cal.com https://www.paytr.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xjbqesljonbbduldeesd.supabase.co; font-src 'self'; connect-src 'self' https://xjbqesljonbbduldeesd.supabase.co wss://xjbqesljonbbduldeesd.supabase.co; frame-src https:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dogrula/:no",
      "destination": "/dogrula.html"
    },
    {
      "source": "/dogrula",
      "destination": "/dogrula.html"
    },
    {
      "source": "/odeme",
      "destination": "/odeme.html"
    }
  ],
  "redirects": [
    {
      "source": "/mesafeli-satis-sozlesmesi",
      "destination": "/sozlesmeler/mesafeli-satis-sozlesmesi.html",
      "permanent": false
    },
    {
      "source": "/gizlilik",
      "destination": "/sozlesmeler/gizlilik-ve-cerez-politikasi.html",
      "permanent": false
    },
    {
      "source": "/yasal-uyarilar",
      "destination": "/sozlesmeler/yasal-uyarilar.html",
      "permanent": false
    },
    {
      "source": "/uyelik",
      "destination": "/sozlesmeler/uyelik-sozlesmesi.html",
      "permanent": false
    },
    {
      "source": "/iletisim",
      "destination": "/sozlesmeler/iletisim.html",
      "permanent": false
    },
    {
      "source": "/kimdir",
      "destination": "/sozlesmeler/hakkimizda.html",
      "permanent": false
    },
    {
      "source": "/refund_returns",
      "destination": "/sozlesmeler/iptal-ve-iade.html",
      "permanent": false
    },
    {
      "source": "/magaza",
      "destination": "/#magaza",
      "permanent": false
    },
    {
      "source": "/cart",
      "destination": "/odeme.html",
      "permanent": false
    },
    {
      "source": "/urun/satisin-sifreleri-online-egitim",
      "destination": "/odeme.html?urun=ss",
      "permanent": false
    },
    {
      "source": "/urun/gayrimenkulun-usta-satiscilari-online-egitim",
      "destination": "/odeme.html?urun=gus",
      "permanent": false
    },
    {
      "source": "/course/:slug",
      "destination": "/#magaza",
      "permanent": false
    }
  ]
}
