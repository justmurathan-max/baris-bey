{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dogrula/:no",
      "destination": "/dogrula.html"
    },
    {
      "source": "/dogrula",
      "destination": "/dogrula.html"
    }
  ]
}
